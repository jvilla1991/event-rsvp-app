# Copy to `.env` for local development (`.env` is gitignored).

# Base URL of the EventRsvp API.
VITE_API_URL=http://localhost:5000

# Wedding invite routing (optional).
# When a link is generated for the event whose id matches VITE_WEDDING_EVENT_ID,
# it points at the themed wedding website instead of the generic in-app event
# page. Leave both blank to keep every event on /event/:id.
VITE_WEDDING_URL=http://localhost:4200
VITE_WEDDING_EVENT_ID=9
